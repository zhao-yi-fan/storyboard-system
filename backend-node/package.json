{
  "name": "storyboard-backend-node",
  "version": "0.1.0",
  "private": true,
  "description": "Egg.js migration backend for storyboard-system",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "npm run build && egg-bin dev --baseDir dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --check .",
    "start": "egg-scripts start dist --daemon --title=storyboard-backend-node",
    "stop": "egg-scripts stop --title=storyboard-backend-node",
    "test": "egg-bin test"
  },
  "egg": {
    "typescript": true
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.5",
    "ali-oss": "^6.23.0",
    "dotenv": "^16.6.1",
    "egg": "^3.31.0",
    "egg-scripts": "^2.17.0",
    "mysql2": "^3.15.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "egg-bin": "^6.13.0",
    "egg-mock": "^5.14.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=18"
  }
}
